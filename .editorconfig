root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.ps1]
end_of_line = crlf

# CSV bytes and newlines are part of the existing data contract.
[*.csv]
end_of_line = unset
insert_final_newline = unset
